# ────────────────────────────────────────────────────────────────
# Frontend (Vite) — these are EXPOSED to the browser bundle.
# Never put secrets here.
# ────────────────────────────────────────────────────────────────

# Firebase Client SDK (get from Firebase Console → Project Settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# The Firestore device document ID that your ESP32 uses
# Must match the deviceId the ESP32 sends in its requests
VITE_DEVICE_ID=attendance-device-01

# ────────────────────────────────────────────────────────────────
# Server-only (Vercel Environment Variables)
# NEVER prefix these with VITE_ — they must never reach the browser.
# Set these in: Vercel Dashboard → Project → Settings → Environment Variables
# ────────────────────────────────────────────────────────────────

# Firebase Admin SDK — from Firebase Console → Project Settings → Service Accounts
# → Generate new private key → download JSON → copy values below
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key exactly as it appears in the JSON (with \n newlines)
FIREBASE_PRIVATE_KEY=

# A long random secret shared between the ESP32 firmware and the Vercel API.
# Generate one with: openssl rand -hex 32
# The ESP32 sends this as: Authorization: Bearer <DEVICE_API_KEY>
DEVICE_API_KEY=
